# Discord channel webhook: Channel settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Anthropic API key, for the podcast script (npm run podcast:script): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key, for the podcast audio (npm run podcast:audio): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Admin keys, for the local costs dashboard only (npm run costs): they can read the whole
# organisation's billing, so keep them in this local file, never in GitHub secrets.
# Anthropic: https://platform.claude.com/settings/admin-keys (needs an organisation, not an individual account)
ANTHROPIC_ADMIN_KEY=
# OpenAI: https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
