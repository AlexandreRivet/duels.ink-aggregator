# Discord channel webhook: Channel settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Anthropic API key, for the podcast script (npm run podcast:script): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key, for the podcast audio (npm run podcast:audio): https://platform.openai.com/api-keys
OPENAI_API_KEY=
